node_modules/

# www/ is generated by `npm run build` from cornerman.html, css/, js/ —
# no need to commit it, it's rebuilt automatically before every cap sync.
www/

# iOS build artifacts (the ios/ project itself IS committed once created)
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/

# Android build artifacts (the android/ project itself IS committed once created)
android/.gradle/
android/app/build/
android/build/
android/local.properties
